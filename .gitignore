# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Secrets
.env

# Raw data (kept locally, not committed). Two small samples are force-added with
# `git add -f`: a 1-day calls pull (run_ts=sample_day) and one scorecard pull. They
# feed tests/test_end_to_end.py. Everything else is reproducible via `python -m pipeline.extract`.
data/raw/*

# Processed data and local warehouse
data/processed/*
!data/processed/.gitkeep
*.duckdb
*.duckdb.wal

# Pipeline outputs regenerated by every run (evidence copies live in outputs/<month>/ and are committed selectively)
logs/*
!logs/.gitkeep

# Chaos-test outputs (run_pipeline.py --chaos) - never a real KPI pack
outputs/_chaos/

# OS
.DS_Store
Thumbs.db

# Claude Code project instructions - not part of the deliverable
claude.md
CLAUDE.md
