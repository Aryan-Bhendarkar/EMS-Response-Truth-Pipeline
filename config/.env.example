# Copy this file to .env (gitignored) and fill in real values.

# Socrata app token for data.sf.gov — free to register at https://data.sf.gov/profile/edit/developer_settings
# Raises the anonymous rate limit; requests still work without it but throttle sooner.
SOCRATA_APP_TOKEN=

# Optional: Socrata username/password, only needed for write access (not used by this project).
SOCRATA_USERNAME=
SOCRATA_PASSWORD=
