# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Secrets
.env

# Raw data (kept locally, not committed) — one sample month is force-added
# with `git add -f` for reviewers (see docs/source_map.md); everything else
# stays local since it's fully reproducible via `python -m pipeline.extract`.
data/raw/*
!data/raw/.gitkeep

# Processed data and local warehouse
data/processed/*
!data/processed/.gitkeep
*.duckdb
*.duckdb.wal

# Pipeline outputs regenerated by every run (evidence copies live in outputs/<month>/ and are committed selectively)
logs/*
!logs/.gitkeep

# OS
.DS_Store
Thumbs.db

